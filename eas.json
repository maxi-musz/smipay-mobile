        "EXPO_PUBLIC_APP_ENV": "staging",
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "true",
        "EXPO_PUBLIC_API_VERSION": "/api/v1",
        "EXPO_PUBLIC_AIRTIME_PROVIDER": "vtpass",
        "EXPO_PUBLIC_DATA_PROVIDER": "vtpass",
        "EXPO_PUBLIC_CABLE_TV_PROVIDER": "vtpass",
        "EXPO_PUBLIC_EDUCATION_PROVIDER": "vtpass",
        "EXPO_PUBLIC_UTILITY_PROVIDER": "vtpass",
        "EXPO_PUBLIC_REQUEST_SIGNING_SECRET":"c79a5879f3355adbccdef6c9eac1f2edc3496528dfd1304b08442826347b90ce"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://prod-server.smipay.ng",
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_ANALYTICS_ENABLED": "true",
        "EXPO_PUBLIC_API_VERSION": "/api/v1",
        "EXPO_PUBLIC_AIRTIME_PROVIDER": "vtpass",
        "EXPO_PUBLIC_DATA_PROVIDER": "vtpass",
        "EXPO_PUBLIC_CABLE_TV_PROVIDER": "vtpass",
        "EXPO_PUBLIC_EDUCATION_PROVIDER": "vtpass",
        "EXPO_PUBLIC_UTILITY_PROVIDER": "vtpass",
