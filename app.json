{
  "expo": {
    "name": "SmiPay",
    "slug": "smipay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smipay",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smipay.mobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "SmiPay uses Face ID to unlock the app securely."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.smipay.mobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F4831F",
          "sounds": [
            "./assets/sounds/notification-1.wav"
          ]
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow SmiPay to use Face ID to unlock the app securely."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysPermission": false,
          "locationWhenInUsePermission": "SmiPay uses your approximate location to help protect your account from unauthorized access and detect suspicious activity."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "589fbf17-a8c3-49b0-9d9c-ba2b048f2887"
      }
    },
    "owner": "besttechltd"
  }
}
